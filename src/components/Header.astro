---
import { NAV_LINKS, SOCIAL_LINKS, SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
	<div class="container container--wide header-inner">
		<a class="brand" href="/">
			<span class="brand-mark" aria-hidden="true">K</span>
			<span class="brand-text">{SITE_TITLE}</span>
		</a>

		<nav class="nav" aria-label="主导航">
			{
				NAV_LINKS.map((link) => (
					<a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="header-actions">
			{SOCIAL_LINKS.map((link) =>
				link.href.startsWith('http') ? (
					<a class="social" href={link.href} target="_blank" rel="noopener noreferrer">
						{link.label}
					</a>
				) : (
					<a class="social" href={link.href}>
						{link.label}
					</a>
				),
			)}
			<button
				id="theme-toggle"
				class="icon-button"
				type="button"
				aria-label="切换深色模式"
				title="切换深色模式"
			>
				<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="4.2"></circle>
					<path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6"></path>
				</svg>
				<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M20.5 14.6A8.6 8.6 0 1 1 9.4 3.5a7 7 0 0 0 11.1 11.1z"></path>
				</svg>
			</button>
		</div>
	</div>
</header>

<script is:inline>
	(function () {
		var btn = document.getElementById('theme-toggle');
		if (!btn) return;
		btn.addEventListener('click', function () {
			var root = document.documentElement;
			var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
			root.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch (e) {}
		});
	})();
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		backdrop-filter: saturate(180%) blur(12px);
		border-bottom: 1px solid var(--border);
	}

	.header-inner {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		height: 3.75rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--fg);
		font-weight: 650;
		font-size: 0.95rem;
		letter-spacing: -0.01em;
	}

	.brand:hover {
		text-decoration: none;
	}

	.brand-mark {
		display: grid;
		place-items: center;
		width: 1.6rem;
		height: 1.6rem;
		border-radius: 7px;
		background: var(--accent);
		color: var(--bg);
		font-size: 0.85rem;
		font-weight: 700;
	}

	.nav {
		display: flex;
		gap: 0.25rem;
		margin-right: auto;
	}

	.nav a {
		padding: 0.35rem 0.6rem;
		border-radius: 7px;
		color: var(--fg-muted);
		font-size: 0.9rem;
	}

	.nav a:hover {
		color: var(--fg);
		background: var(--bg-subtle);
		text-decoration: none;
	}

	.nav a[aria-current='page'] {
		color: var(--fg);
		background: var(--bg-subtle);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.social {
		color: var(--fg-muted);
		font-size: 0.85rem;
	}

	.social:hover {
		color: var(--accent);
		text-decoration: none;
	}

	.icon-button {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: transparent;
		color: var(--fg-muted);
		cursor: pointer;
	}

	.icon-button:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.icon-button svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
	}

	html[data-theme='dark'] .icon-sun,
	:global(html:not([data-theme='dark'])) .icon-moon {
		display: none;
	}

	@media (max-width: 640px) {
		.brand-text,
		.social {
			display: none;
		}
		.nav a {
			padding: 0.35rem 0.5rem;
		}
	}
</style>
