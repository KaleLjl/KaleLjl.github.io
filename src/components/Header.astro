---
import { NAV_LINKS, SITE_WORDMARK } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-head">
	<div class="container head-inner">
		<a class="wordmark" href="/">{SITE_WORDMARK.main.toUpperCase()}</a>

		<nav class="nav" aria-label="主导航">
			{
				NAV_LINKS.map((link) => (
					<a
						href={link.href}
						aria-current={isActive(link.href) ? 'page' : undefined}
						class:list={[{ current: isActive(link.href) }]}
					>
						{link.label}
					</a>
				))
			}
			<a href="/rss.xml">RSS</a>
			<button id="theme-toggle" class="toggle" type="button" title="切换深浅色">深浅</button>
		</nav>
	</div>
</header>

<script is:inline>
	(function () {
		var btn = document.getElementById('theme-toggle');
		if (!btn) return;
		btn.addEventListener('click', function () {
			var root = document.documentElement;
			var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
			root.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch (e) {}
		});
	})();
</script>

<style>
	.site-head {
		padding: 1.75rem 0 0.5rem;
	}

	.head-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 1.5rem;
	}

	.wordmark {
		font-family: var(--font-ui);
		font-size: 0.72rem;
		font-weight: bold;
		letter-spacing: 0.35em;
		color: var(--ink-faint);
		text-decoration: none;
	}

	.wordmark:hover {
		color: var(--ink);
	}

	.nav {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.9rem;
		font-family: var(--font-ui);
		font-size: 0.8125rem;
	}

	.nav a {
		color: var(--link);
	}

	.nav a.current {
		color: var(--ink);
		text-decoration: none;
	}

	.toggle {
		padding: 0;
		border: none;
		background: none;
		font-family: var(--font-ui);
		font-size: 0.8125rem;
		color: var(--ink-faint);
		cursor: pointer;
	}

	.toggle:hover {
		color: var(--link);
		text-decoration: underline;
	}
</style>
