---
interface Props {
	date: Date;
}

const { date } = Astro.props;

// 固定用 UTC，避免时区把日期显示成前一天
const formatted = new Intl.DateTimeFormat('zh-CN', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC',
}).format(date);

const iso = date.toISOString().slice(0, 10);
---

<time datetime={iso}>{formatted}</time>
