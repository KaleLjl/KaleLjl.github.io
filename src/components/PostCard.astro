---
import FormattedDate from './FormattedDate.astro';
import { postPath, readingTime, type Post } from '../lib/posts';

interface Props {
	post: Post;
	showDraft?: boolean;
}

const { post, showDraft = false } = Astro.props;
const { title, description, pubDate, tags, draft } = post.data;
const minutes = readingTime(post.body);
---

<article class="post-card">
	<div class="meta">
		<FormattedDate date={pubDate} />
		<span aria-hidden="true">·</span>
		<span>{minutes} 分钟</span>
		{showDraft && draft && <span class="draft-badge">草稿</span>}
	</div>

	<h2 class="title">
		<a href={postPath(post)}>{title}</a>
	</h2>

	<p class="description">{description}</p>

	{
		tags.length > 0 && (
			<ul class="tags">
				{tags.map((tag) => (
					<li>
						<a class="tag" href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`}>
							{tag}
						</a>
					</li>
				))}
			</ul>
		)
	}
</article>

<style>
	.post-card {
		padding: 1.5rem 0;
		border-bottom: 1px solid var(--border);
	}

	.post-card:last-child {
		border-bottom: none;
	}

	.title {
		margin: 0.4rem 0 0.5rem;
		font-size: 1.2rem;
		font-weight: 650;
	}

	.title a {
		color: var(--fg);
	}

	.title a:hover {
		color: var(--accent);
		text-decoration: none;
	}

	.description {
		margin: 0 0 0.75rem;
		color: var(--fg-muted);
		font-size: 0.95rem;
		line-height: 1.7;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.draft-badge {
		padding: 0.05em 0.45em;
		border-radius: 4px;
		background: #b4530920;
		color: #b45309;
		font-size: 0.72rem;
		font-weight: 600;
	}
</style>
