---
import { postPath, postTitle, type Post } from '../lib/posts';

interface Props {
	post: Post;
	showDraft?: boolean;
}

const { post, showDraft = false } = Astro.props;
const { draft } = post.data;
const title = postTitle(post);
---

<p class="item">
	<a href={postPath(post)}>{title}</a>
	{showDraft && draft && <span class="draft"> (草稿)</span>}
</p>

<style>
	.item {
		font-family: var(--font-ui);
		font-size: 0.8125rem;
		line-height: 1.75;
		margin: 0 0 0.15rem;
		text-indent: -0.95rem;
		padding-left: 0.95rem;
	}

	/* 红方点：PG 列表的标志 */
	.item::before {
		content: '';
		display: inline-block;
		width: 5px;
		height: 5px;
		margin-right: 0.55em;
		background: var(--bullet);
		vertical-align: 0.18em;
	}

	.draft {
		color: var(--ink-faint);
	}
</style>
