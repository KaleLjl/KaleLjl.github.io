---
import { postPath, type Post } from '../lib/posts';

interface Props {
	post: Post;
	variant?: 'index' | 'archive';
	showDraft?: boolean;
}

const { post, variant = 'index', showDraft = false } = Astro.props;
const { title, pubDate, draft } = post.data;

const iso = pubDate.toISOString().slice(0, 10);
const dateLabel = `${pubDate.getUTCFullYear()}-${String(pubDate.getUTCMonth() + 1).padStart(2, '0')}-${String(pubDate.getUTCDate()).padStart(2, '0')}`;
---

{
	variant === 'index' ? (
		<p class="item item--index">
			<a href={postPath(post)}>{title}</a>
			{showDraft && draft && <span class="draft"> (草稿)</span>}
		</p>
	) : (
		<p class="item item--archive">
			<a href={postPath(post)}>{title}</a>
			{showDraft && draft && <span class="draft"> (草稿)</span>}
			<time class="date" datetime={iso}>
				{dateLabel}
			</time>
		</p>
	)
}

<style>
	.item {
		font-family: var(--font-ui);
		font-size: 0.8125rem;
		line-height: 1.75;
		margin: 0 0 0.15rem;
		text-indent: -0.95rem;
		padding-left: 0.95rem;
	}

	/* 红方点：PG 列表的标志 */
	.item::before {
		content: '';
		display: inline-block;
		width: 5px;
		height: 5px;
		margin-right: 0.55em;
		background: var(--bullet);
		vertical-align: 0.18em;
	}

	.item--archive {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		text-indent: 0;
		padding-left: 0.95rem;
	}

	.item--archive::before {
		flex: none;
		margin-left: -0.95rem;
	}

	.item--archive a {
		flex: 1;
	}

	.date {
		flex: none;
		color: var(--ink-faint);
		font-variant-numeric: tabular-nums;
	}

	.draft {
		color: var(--ink-faint);
	}
</style>
