---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="这个页面走丢了。">
	<div class="wrap">
		<p class="code">404</p>
		<h1>这个页面走丢了</h1>
		<p class="hint">
			可能是链接写错了，或者文章已经被重命名。
		</p>
		<p class="actions">
			<a href="/">回首页</a>
			<a href="/posts/">看看全部文章</a>
		</p>
	</div>
</BaseLayout>

<style>
	.wrap {
		padding: 4rem 0;
		text-align: center;
	}

	.code {
		font-size: 3rem;
		font-weight: 700;
		color: var(--border);
		margin: 0;
		letter-spacing: 0.05em;
	}

	h1 {
		font-size: 1.5rem;
		margin: 0.5rem 0 0.75rem;
	}

	.hint {
		color: var(--fg-muted);
		margin-bottom: 2rem;
	}

	.actions {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
		font-size: 0.92rem;
	}
</style>
