---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import { getPosts, postPath } from '../lib/posts';

const posts = await getPosts();

// 推荐入口：最新的两篇
const picks = posts.slice(0, 2);
---

<BaseLayout>
	<p class="label">随笔</p>

	{
		picks.length > 0 && (
			<p class="small intro">
				不知道从哪开始？试试
				{picks.map((post, i) => (
					<>
						{i > 0 && (i === picks.length - 1 ? '，或者 ' : '、')}
						<a href={postPath(post)}>《{post.data.title}》</a>
					</>
				))}
				。
			</p>
		)
	}

	<section class="list">
		{posts.map((post) => <PostRow post={post} showDraft />)}
		{posts.length === 0 && <p class="small intro">还没有文章。</p>}
	</section>

	<p class="small footnote">
		<a href="/posts/">按时间归档</a> · <a href="/rss.xml">RSS 订阅</a>
	</p>
</BaseLayout>

<style>
	.intro {
		margin: 0 0 1.5rem;
	}

	.list {
		margin-bottom: 2rem;
	}

	.footnote {
		color: var(--ink-muted);
	}
</style>
