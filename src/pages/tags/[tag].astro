---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts, getTags, tagSlug } from '../../lib/posts';

export async function getStaticPaths() {
	const [posts, tags] = await Promise.all([getPosts(), getTags()]);
	return tags.map(({ tag, count }) => ({
		params: { tag: tagSlug(tag) },
		props: {
			tag,
			count,
			posts: posts.filter((post) => post.data.tags.includes(tag)),
		},
	}));
}

const { tag, count, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`标签「${tag}」下的 ${count} 篇文章。`}>
	<p class="label">标签</p>
	<p class="small intro">
		{tag}（{count} 篇） · <a href="/tags/">全部标签</a>
	</p>

	<div>
		{posts.map((post) => <PostRow post={post} showDraft />)}
	</div>
</BaseLayout>

<style>
	.intro {
		margin: 0 0 1.5rem;
	}
</style>
