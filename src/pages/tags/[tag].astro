---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts, getTags, tagSlug } from '../../lib/posts';

export async function getStaticPaths() {
	const [posts, tags] = await Promise.all([getPosts(), getTags()]);
	return tags.map(({ tag, count }) => ({
		params: { tag: tagSlug(tag) },
		props: {
			tag,
			count,
			posts: posts.filter((post) => post.data.tags.includes(tag)),
		},
	}));
}

const { tag, count, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`标签「${tag}」下的 ${count} 篇文章。`}>
	<p class="back"><a href="/tags/">← 标签索引</a></p>

	<header class="page-head">
		<p class="kicker">Tagged</p>
		<h1>{tag}</h1>
		<p class="meta">{count} 篇文章</p>
	</header>

	<div class="rows">
		{posts.map((post, i) => <PostRow post={post} index={i + 1} showDraft />)}
	</div>
</BaseLayout>

<style>
	.back {
		margin: 0 0 1.25rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
	}

	.back a {
		color: var(--ink-faint);
	}

	.back a:hover {
		color: var(--accent);
	}

	.page-head {
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--rule-strong);
	}

	.page-head h1 {
		margin: 0 0 0.4rem;
		font-size: clamp(1.6rem, 4.5vw, 2rem);
	}
</style>
