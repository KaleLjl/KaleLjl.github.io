---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, getTags, tagSlug } from '../../lib/posts';

export async function getStaticPaths() {
	const [posts, tags] = await Promise.all([getPosts(), getTags()]);
	return tags.map(({ tag, count }) => ({
		params: { tag: tagSlug(tag) },
		props: {
			tag,
			count,
			posts: posts.filter((post) => post.data.tags.includes(tag)),
		},
	}));
}

const { tag, count, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`标签「${tag}」下的 ${count} 篇文章。`} wide>
	<p class="back"><a href="/tags/">← 全部标签</a></p>
	<h1 class="page-title">{tag}</h1>
	<p class="page-desc">{count} 篇文章</p>

	<div class="post-list">
		{posts.map((post) => <PostCard post={post} showDraft />)}
	</div>
</BaseLayout>

<style>
	.back {
		margin: 0 0 1rem;
		font-size: 0.85rem;
	}

	.page-title {
		margin-bottom: 0.2rem;
		font-size: 1.8rem;
	}

	.page-desc {
		color: var(--fg-muted);
		font-size: 0.9rem;
		margin-bottom: 1.5rem;
	}
</style>
