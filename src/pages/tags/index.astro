---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTags, tagSlug } from '../../lib/posts';

const tags = await getTags();
---

<BaseLayout title="标签" description="按标签浏览文章。">
	<header class="page-head">
		<p class="kicker">Index</p>
		<h1>标签</h1>
		<p class="meta">共 {tags.length} 个</p>
	</header>

	{
		tags.length === 0 ? (
			<p class="empty">还没有标签。</p>
		) : (
			<ul class="tag-list">
				{tags.map(({ tag, count }) => (
					<li>
						<a href={`/tags/${tagSlug(tag)}/`}>
							<span class="name">{tag}</span>
							<span class="leader" aria-hidden="true" />
							<span class="count">{count}</span>
						</a>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>

<style>
	.page-head {
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--rule-strong);
	}

	.page-head h1 {
		margin: 0 0 0.4rem;
		font-size: clamp(1.8rem, 5vw, 2.3rem);
	}

	.tag-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tag-list li {
		border-bottom: 1px solid var(--rule);
	}

	.tag-list a {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		padding: 0.9rem 0;
	}

	.name {
		font-family: var(--font-serif);
		font-size: 1.05rem;
		color: var(--ink);
	}

	.tag-list a:hover .name {
		color: var(--accent);
	}

	/* 目录式的点线引导 */
	.leader {
		flex: 1;
		border-bottom: 1px dotted var(--rule-strong);
		transform: translateY(-0.25em);
	}

	.count {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--ink-faint);
		font-variant-numeric: tabular-nums;
	}

	.empty {
		padding: 2rem 0;
		color: var(--ink-muted);
	}
</style>
