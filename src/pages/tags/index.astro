---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTags, tagSlug } from '../../lib/posts';

const tags = await getTags();
---

<BaseLayout title="标签" description="按标签浏览文章。">
	<h1 class="page-title">标签</h1>
	<p class="page-desc">共 {tags.length} 个标签。</p>

	{
		tags.length === 0 ? (
			<p class="empty">还没有标签。</p>
		) : (
			<ul class="tag-list">
				{tags.map(({ tag, count }) => (
					<li>
						<a href={`/tags/${tagSlug(tag)}/`}>
							<span class="name">{tag}</span>
							<span class="count">{count} 篇</span>
						</a>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>

<style>
	.page-title {
		margin-bottom: 0.3rem;
		font-size: 1.8rem;
	}

	.page-desc {
		color: var(--fg-muted);
		font-size: 0.9rem;
		margin-bottom: 2rem;
	}

	.tag-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tag-list li {
		border-bottom: 1px solid var(--border);
	}

	.tag-list a {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 0.25rem;
		color: var(--fg);
	}

	.tag-list a:hover {
		color: var(--accent);
		text-decoration: none;
	}

	.count {
		color: var(--fg-faint);
		font-size: 0.82rem;
		font-variant-numeric: tabular-nums;
	}

	.empty {
		color: var(--fg-muted);
	}
</style>
