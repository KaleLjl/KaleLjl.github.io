---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTags, tagSlug } from '../../lib/posts';

const tags = await getTags();
---

<BaseLayout title="标签" description="按标签浏览文章。">
	<p class="label">标签</p>
	<p class="small intro">共 {tags.length} 个。也可以看<a href="/">全部文章</a>。</p>

	<div class="tag-list small">
		{
			tags.map(({ tag, count }) => (
				<p class="tag-item">
					<a href={`/tags/${tagSlug(tag)}/`}>{tag}</a> <span class="count">({count})</span>
				</p>
			))
		}
		{tags.length === 0 && <p>还没有标签。</p>}
	</div>
</BaseLayout>

<style>
	.intro {
		margin: 0 0 1.5rem;
	}

	.tag-item {
		margin: 0 0 0.15rem;
		text-indent: -0.95rem;
		padding-left: 0.95rem;
	}

	.tag-item::before {
		content: '';
		display: inline-block;
		width: 5px;
		height: 5px;
		margin-right: 0.55em;
		background: var(--bullet);
		vertical-align: 0.18em;
	}

	.count {
		color: var(--ink-faint);
	}
</style>
