---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getPosts, postPath, readingTime, tagSlug } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			prev: posts[index + 1] ?? null,
			next: posts[index - 1] ?? null,
		},
	}));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, tags, draft, heroImage } = post.data;

const minutes = readingTime(post.body);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={title} description={description} type="article" pubDate={pubDate}>
	<article>
		<header class="post-head">
			<h1>{title}</h1>

			<p class="meta byline">
				<FormattedDate date={pubDate} />
				<span aria-hidden="true">/</span>
				<span>{minutes} 分钟</span>
				{updatedDate && (
					<>
						<span aria-hidden="true">/</span>
						<span>更新于 <FormattedDate date={updatedDate} /></span>
					</>
				)}
				{draft && <span class="draft">草稿</span>}
			</p>
		</header>

		{heroImage && <Image class="hero" src={heroImage} alt="" widths={[640, 1000]} sizes="(max-width: 720px) 100vw, 640px" loading="eager" />}

		{
			toc.length >= 3 && (
				<nav class="toc" aria-label="目录">
					<p class="kicker">Contents</p>
					<ol>
						{toc.map((h) => (
							<li class:list={[{ 'is-sub': h.depth === 3 }]}>
								<a href={`#${h.slug}`}>{h.text}</a>
							</li>
						))}
					</ol>
				</nav>
			)
		}

		<div class="prose">
			<Content />
		</div>

		{
			tags.length > 0 && (
				<footer class="post-foot">
					<p class="kicker">Filed under</p>
					<ul class="tags">
						{tags.map((tag) => (
							<li>
								<a class="tag" href={`/tags/${tagSlug(tag)}/`}>
									{tag}
								</a>
							</li>
						))}
					</ul>
				</footer>
			)
		}
	</article>

	{
		(prev || next) && (
			<nav class="post-nav" aria-label="上一篇 / 下一篇">
				{prev ? (
					<a class="nav-item" href={postPath(prev)}>
						<span class="nav-label">← 上一篇</span>
						<span class="nav-title">{prev.data.title}</span>
					</a>
				) : (
					<span />
				)}
				{next && (
					<a class="nav-item nav-item--right" href={postPath(next)}>
						<span class="nav-label">下一篇 →</span>
						<span class="nav-title">{next.data.title}</span>
					</a>
				)}
			</nav>
		)
	}
</BaseLayout>

<style>
	.post-head {
		max-width: var(--width-reading);
		margin: 0 auto 1.75rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--rule-strong);
	}

	.post-head h1 {
		margin: 0 0 1rem;
		font-size: clamp(1.75rem, 4.8vw, 2.4rem);
		line-height: 1.35;
		font-weight: 600;
	}

	.byline {
		margin: 0;
	}

	.draft {
		padding: 0.05em 0.4em;
		border: 1px solid var(--accent);
		border-radius: 2px;
		font-size: 0.66rem;
		color: var(--accent);
	}

	.hero {
		display: block;
		max-width: var(--width-reading);
		margin: 0 auto 2rem;
	}

	.toc {
		max-width: var(--width-reading);
		margin: 0 auto 2.5rem;
		padding-left: 1rem;
		border-left: 1px solid var(--rule-strong);
	}

	.toc .kicker {
		margin-bottom: 0.6rem;
		color: var(--ink-faint);
	}

	.toc ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.toc li {
		margin: 0.3rem 0;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		line-height: 1.7;
	}

	.toc li.is-sub {
		padding-left: 1.1rem;
		opacity: 0.75;
	}

	.toc a {
		color: var(--ink-muted);
	}

	.toc a:hover {
		color: var(--accent);
	}

	.post-foot {
		max-width: var(--width-reading);
		margin: 3.5rem auto 0;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		max-width: var(--width-reading);
		margin: 3rem auto 0;
		border-top: 1px solid var(--rule-strong);
	}

	.nav-item {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 1.25rem 1.25rem 1.25rem 0;
	}

	.nav-item--right {
		padding: 1.25rem 0 1.25rem 1.25rem;
		border-left: 1px solid var(--rule);
		text-align: right;
	}

	.nav-label {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.06em;
		color: var(--ink-faint);
	}

	.nav-title {
		font-family: var(--font-serif);
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--ink);
	}

	.nav-item:hover .nav-title {
		color: var(--accent);
	}

	@media (max-width: 560px) {
		.post-nav {
			grid-template-columns: 1fr;
		}

		.nav-item--right {
			grid-column: 1;
			border-left: none;
			border-top: 1px solid var(--rule);
			padding: 1.25rem 0;
			text-align: left;
		}

		.nav-item {
			padding: 1.25rem 0;
		}
	}
</style>
