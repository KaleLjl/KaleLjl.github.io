---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getPosts, postPath } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			prev: posts[index + 1] ?? null,
			next: posts[index - 1] ?? null,
		},
	}));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, draft, heroImage } = post.data;
---

<BaseLayout title={title} description={description} type="article" pubDate={pubDate}>
	<article>
		<h1 class="title">{title}{draft && <span class="draft"> （草稿）</span>}</h1>

		<p class="small dateline">
			<FormattedDate date={pubDate} />
			{updatedDate && <> · 更新于 <FormattedDate date={updatedDate} /></>}
		</p>

		{heroImage && <Image class="hero" src={heroImage} alt="" widths={[640, 1000]} sizes="(max-width: 720px) 100vw, 640px" loading="eager" />}

		<div class="prose">
			<Content />
		</div>

		<p class="small footer-line">
			<a href="/">← 全部文章</a>
		</p>

		{
			(prev || next) && (
				<p class="small footer-line">
					{prev && (
						<>
							上一篇：<a href={postPath(prev)}>{prev.data.title}</a>
						</>
					)}
					{prev && next && ' · '}
					{next && (
						<>
							下一篇：<a href={postPath(next)}>{next.data.title}</a>
						</>
					)}
				</p>
			)
		}
	</article>
</BaseLayout>

<style>
	.title {
		font-size: 1.45rem;
		margin: 0 0 0.5rem;
		line-height: 1.45;
	}

	.draft {
		font-family: var(--font-ui);
		font-size: 0.75rem;
		font-weight: normal;
		color: var(--ink-faint);
	}

	.dateline {
		margin: 0 0 1.75rem;
		color: var(--ink-muted);
	}

	.hero {
		display: block;
		margin: 0 0 1.75rem;
	}

	.footer-line {
		margin: 1.75rem 0 0;
		color: var(--ink-muted);
	}
</style>
