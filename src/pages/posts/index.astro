---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();

const groups = new Map<string, typeof posts>();
for (const post of posts) {
	const year = String(post.data.pubDate.getUTCFullYear());
	groups.set(year, [...(groups.get(year) ?? []), post]);
}
---

<BaseLayout title="归档" description="按时间倒序排列的全部文章。">
	<p class="label">归档</p>
	<p class="small intro">
		共 {posts.length} 篇，按时间倒序。也可以回<a href="/">首页</a>看完整列表。
	</p>

	{
		[...groups.entries()].map(([year, items]) => (
			<section class="year">
				<h2 class="year-label">{year}</h2>
				{items.map((post) => (
					<PostRow post={post} variant="archive" showDraft />
				))}
			</section>
		))
	}
</BaseLayout>

<style>
	.intro {
		margin: 0 0 1.75rem;
	}

	.year {
		margin-bottom: 1.5rem;
	}

	.year-label {
		margin: 0 0 0.5rem;
		font-family: var(--font-ui);
		font-size: 0.72rem;
		font-weight: bold;
		letter-spacing: 0.08em;
		color: var(--ink-muted);
	}</style>
