---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const groups = new Map<string, typeof posts>();

for (const post of posts) {
	const year = String(post.data.pubDate.getUTCFullYear());
	groups.set(year, [...(groups.get(year) ?? []), post]);
}
---

<BaseLayout title="全部文章" description="按时间倒序排列的全部文章。" wide>
	<h1 class="page-title">全部文章</h1>
	<p class="page-desc">共 {posts.length} 篇，按时间倒序。</p>

	{
		posts.length === 0 && (
			<p class="empty">
				还没有文章。往 <code>src/content/posts/</code> 里放一个 <code>.md</code> 文件就会出现在这里。
			</p>
		)
	}

	{
		[...groups.entries()].map(([year, items]) => (
			<section class="year-group">
				<h2>{year}</h2>
				<div class="post-list">
					{items.map((post) => (
						<PostCard post={post} showDraft />
					))}
				</div>
			</section>
		))
	}
</BaseLayout>

<style>
	.page-title {
		margin-bottom: 0.3rem;
		font-size: 1.8rem;
	}

	.page-desc {
		color: var(--fg-muted);
		font-size: 0.9rem;
		margin-bottom: 2rem;
	}

	.year-group {
		margin-bottom: 2rem;
	}

	.year-group h2 {
		font-size: 0.85rem;
		color: var(--fg-faint);
		font-weight: 600;
		letter-spacing: 0.08em;
		margin-bottom: 0.25rem;
		font-variant-numeric: tabular-nums;
	}

	.empty {
		color: var(--fg-muted);
	}
</style>
