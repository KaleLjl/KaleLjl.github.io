---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_LANG } from '../consts';

interface Props {
	title?: string;
	description?: string;
	type?: 'website' | 'article';
	image?: string;
	pubDate?: Date;
	wide?: boolean;
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	type,
	image,
	pubDate,
	wide = false,
} = Astro.props;
---

<!doctype html>
<html lang={SITE_LANG} data-theme="light">
	<head>
		<BaseHead title={title} description={description} type={type} image={image} pubDate={pubDate} />
	</head>
	<body id="top">
		<Header />
		<main>
			<div class:list={['container', { 'container--wide': wide }]}>
				<slot />
			</div>
		</main>
		<Footer />
	</body>
</html>
